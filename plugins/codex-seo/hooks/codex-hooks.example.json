{
  "description": "Optional Codex schema review. Review and trust explicitly before enabling. Post-edit checks cannot undo edits.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/run-python-hook.js\" \"${PLUGIN_ROOT}/hooks/codex-schema-check.py\"",
            "timeout": 30,
            "statusMessage": "Reviewing edited structured data"
          }
        ]
      }
    ]
  }
}
